#!/usr/bin/env python3
"""Command-line entry point for Corvée (Python 3.11+)."""

from __future__ import annotations

import sys


def main() -> int:
    commands = {"configure", "models", "select", "show", "check"}
    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help"}:
        print("Usage: corvee COMMAND [OPTIONS]")
        print("Commands: configure, models [PATTERN], select MODEL, show, check, run")
        print("For command help: corvee COMMAND --help")
        print("target, analyze, refine, loop, audit and status are Codex skill instructions;")
        print("invoke them in chat as: $corvee loop")
        return 0
    command, *arguments = sys.argv[1:]
    if command == "run":
        from corvee import main as run

        sys.argv = [sys.argv[0], *arguments]
        return run()
    if command in commands:
        from configure_corvee import main as configure

        # Accept shared config options after the subcommand as users expect.
        shared, rest = [], []
        index = 0
        while index < len(arguments):
            value = arguments[index]
            if value in {"--config", "--timeout"}:
                if index + 1 == len(arguments):
                    print(f"{value} requires a value", file=sys.stderr)
                    return 2
                shared.extend(arguments[index:index + 2])
                index += 2
            elif value.startswith(("--config=", "--timeout=")):
                shared.append(value)
                index += 1
            else:
                rest.append(value)
                index += 1
        sys.argv = [sys.argv[0], *shared, command, *rest]
        return configure()
    print(f"Unknown command: {command}. Use --help.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
