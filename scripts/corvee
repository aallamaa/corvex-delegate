#!/usr/bin/env python3
"""Command-line entry point for Corvée (Python 3.11+)."""

from __future__ import annotations

from pathlib import Path
import argparse
import sys


def _normalize_timeout_aliases(values: list[str]) -> list[str]:
    from corvee import parse_duration

    translated = []
    index = 0
    while index < len(values):
        value = values[index]
        if value == "--timeout":
            if index + 1 >= len(values):
                raise ValueError("--timeout requires a value")
            translated.extend(["--http-timeout", str(parse_duration(values[index + 1]))])
            index += 2
        elif value.startswith("--timeout="):
            translated.append(f"--http-timeout={parse_duration(value.split('=', 1)[1])}")
            index += 1
        else:
            translated.append(value)
            index += 1
    return translated


def main() -> int:
    commands = {"configure", "models", "select", "show", "check"}
    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help"}:
        print("Usage: corvee COMMAND [OPTIONS]")
        print("Commands: configure, models [PATTERN], select MODEL, show, check, cleanup, run")
        print("For command help: corvee COMMAND --help")
        print("target, analyze, refine, loop, audit and status are Codex skill instructions;")
        print("invoke them in chat as: $corvee loop")
        return 0

    raw_args = sys.argv[1:]
    shared_prefix = []
    index = 0
    while index < len(raw_args):
        val = raw_args[index]
        if val in {"--config", "--timeout"}:
            if index + 1 == len(raw_args):
                print(f"{val} requires a value", file=sys.stderr)
                return 2
            shared_prefix.extend(raw_args[index:index + 2])
            index += 2
        elif val.startswith(("--config=", "--timeout=")):
            shared_prefix.append(val)
            index += 1
        else:
            break

    remaining = raw_args[index:]
    if not remaining:
        print("Usage: corvee COMMAND [OPTIONS]", file=sys.stderr)
        return 2

    command, *arguments = remaining
    if command == "cleanup":
        from corvee import parse_duration

        parser = argparse.ArgumentParser(description="Clean old Corvée run reports.")
        parser.add_argument("--repo", type=Path, default=Path.cwd(),
                            help="Repository root containing .codex/corvee/reports")
        parser.add_argument("--reports-dir", type=Path,
                            help="Explicit reports directory (defaults to <repo>/.codex/corvee/reports)")
        parser.add_argument("--timeout", type=parse_duration,
                            help="Compatibility shim; cleanup does not use this option")
        parser.add_argument("--older-than-days", type=int, default=30,
                            help="Delete report directories older than this many days (default: 30)")
        parser.add_argument("--dry-run", action="store_true",
                            help="Show actions without deleting anything")
        parser.add_argument("--config", type=Path,
                            help="Configuration file path")
        cleanup_args = parser.parse_args([*shared_prefix, *arguments])
        from corvee import cleanup_reports
        if cleanup_args.older_than_days < 1:
            print("--older-than-days must be a positive integer", file=sys.stderr)
            return 2
        reports_root = (
            cleanup_args.reports_dir.expanduser().resolve()
            if cleanup_args.reports_dir is not None
            else cleanup_args.repo.expanduser().resolve() / ".codex" / "corvee" / "reports"
        )
        summary = cleanup_reports(reports_root, older_than_days=cleanup_args.older_than_days,
                                 dry_run=cleanup_args.dry_run)
        if summary["failed"] > 0:
            return 1
        return 0
    if command == "run":
        from corvee import main as run

        try:
            translated_prefix_and_args = _normalize_timeout_aliases([*shared_prefix, *arguments])
        except Exception:
            print(f"invalid --timeout value", file=sys.stderr)
            return 2
        sys.argv = [sys.argv[0], *translated_prefix_and_args]
        return run()
    if command in commands:
        from configure_corvee import main as configure

        # Accept shared config options after the subcommand as users expect.
        shared, rest = [], []
        idx = 0
        while idx < len(arguments):
            value = arguments[idx]
            if value in {"--config", "--timeout"}:
                if idx + 1 == len(arguments):
                    print(f"{value} requires a value", file=sys.stderr)
                    return 2
                shared.extend(arguments[idx:idx + 2])
                idx += 2
            elif value.startswith(("--config=", "--timeout=")):
                shared.append(value)
                idx += 1
            else:
                rest.append(value)
                idx += 1
        sys.argv = [sys.argv[0], *shared_prefix, *shared, command, *rest]
        return configure()
    print(f"Unknown command: {command}. Use --help.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
